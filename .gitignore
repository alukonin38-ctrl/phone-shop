# ============================================
# Git Ignore для проекта "Магазин телефонов"
# ============================================

# --------------------------------------------
# 1. Зависимости Node.js
# --------------------------------------------
node_modules/
server/node_modules/
**/node_modules/

# --------------------------------------------
# 2. Базы данных и личные данные
# --------------------------------------------
server/users.db
server/users.db-journal
server/users.json
server/users.json.backup
*.sqlite
*.sqlite3

# --------------------------------------------
# 3. Переменные окружения и секреты
# --------------------------------------------
.env
server/.env
.env.local
.env.*.local

# шаблон окружения коммитим — в нём нет секретов
!server/.env.example

# --------------------------------------------
# 4. Логи
# --------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --------------------------------------------
# 5. Кэш и временные файлы
# --------------------------------------------
.cache/
.parcel-cache/
.npm/
.tmp/
temp/

# --------------------------------------------
# 6. VS Code (кроме полезных настроек)
# --------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --------------------------------------------
# 7. IDE и OS
# --------------------------------------------
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --------------------------------------------
# 8. Резервные копии
# --------------------------------------------
*.bak
*.backup
*.old

# --------------------------------------------
# 9. Тесты и покрытие
# --------------------------------------------
coverage/
.nyc_output/

# Результаты бенчмарков генерируются автоматически — в репозитории они не нужны
server/benchmarks/results/*
!server/benchmarks/results/.gitkeep

# --------------------------------------------
# 10. Сборка
# --------------------------------------------
dist/
build/
out/
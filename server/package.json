{
  "name": "phone-shop-server",
  "version": "1.0.0",
  "description": "Серверная часть для магазина телефонов с регистрацией и хешированием паролей",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest __tests__/validators.test.js __tests__/hashService.test.js __tests__/rateLimiter.test.js",
    "test:e2e": "jest __tests__/api.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bench": "node benchmarks/argon2.bench.js",
    "bench:20mb": "node benchmarks/argon2.bench.js --memory=20480 --parallelism=1 --time=3",
    "scenario": "node scripts/user-scenario.js",
    "front": "npx --yes http-server .. -p 5501 -c-1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "*.js",
      "!server.js",
      "!benchmarks/**",
      "!scripts/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "keywords": [
    "express",
    "argon2",
    "authentication"
  ],
  "author": "Ваше Имя",
  "license": "ISC",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.4"
  }
}

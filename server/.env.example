# ============================================
# Пример переменных окружения для сервера
# Скопируйте файл в .env и подставьте свои значения:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
# ============================================

# Порт сервера (по умолчанию 5000)
PORT=5000

# Дополнительная «соль» приложения (pepper).
# Переменная уже есть в .env проекта; в текущей версии сервер её не использует —
# оставлена как задел, значение менять на работающей базе нельзя.
PEPPER=change-me-to-a-long-random-string

# ------- Параметры Argon2id (необязательно) -------
# Память на один хеш в КиБ: 20480 = 20 МБ, 65536 = 64 МБ (значение по умолчанию)
ARGON2_MEMORY_COST=65536
# Число итераций
ARGON2_TIME_COST=3
# Число потоков (1 — один поток)
ARGON2_PARALLELISM=4

# ------- Для тестов и сценариев (необязательно) -------
# Путь к файлу базы данных (по умолчанию server/users.db)
# DB_PATH=C:/temp/test-users.db
